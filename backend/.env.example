APP_NAME=Quadra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.ir
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

# آدرس اپ برای برگشت از درگاه بانک (معمولاً همان APP_URL)
FRONTEND_URL=https://your-domain.ir

# حالت نمایشی: راهنمای رمزهای نمونه و دکمه‌ی بازنشانی داده‌ها. روی سرور اصلی false بماند.
QUADRA_DEMO=false

# اکانت مدیر که با «php artisan quadra:install» ساخته می‌شود (رمز را خالی بگذارید تا تصادفی ساخته شود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- پیامک کد ورود ----------
# log = فقط در storage/logs/laravel.log نوشته می‌شود (تست) | kavenegar | smsir
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=quadra-otp
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAM=CODE

# ---------- درگاه پرداخت ----------
# fake = صفحه‌ی آزمایشی (روی production خاموش است) | zarinpal
PAYMENT_DRIVER=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quadra
DB_USERNAME=quadra
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
